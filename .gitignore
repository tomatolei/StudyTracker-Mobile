# ====================
# Cordova/Node 忽略文件
# ====================

# 依赖目录（体积大，可重新安装）
node_modules/
plugins/

# 平台目录（体积大，可重新生成）
platforms/

# 构建产物
build/
bak/
.bak/
assets/
resources/

# ====================
# Android/Gradle 忽略文件
# ====================

# Gradle 缓存
.gradle/
*/.gradle/

# Android Studio
.idea/
*.iml
*.hprof
.DS_Store

# 本地配置文件
local.properties

# ====================
# 敏感文件（重要！不要上传）
# ====================

# 签名密钥文件
*.keystore
*.keystore.base64
keystore.properties

# ====================
# 导出文件
# ====================

# Excel/CSV 导出
*.xlsx
*.csv
*.xls

# 备份文件
*.json
!package.json
!package-lock.json

# APK 文件
*.apk
*.aab

# ====================
# 其他临时文件
# ====================

# 日志文件
*.log

# 系统文件
Thumbs.db
.DS_Store

# 本地脚本文件
*.bat
